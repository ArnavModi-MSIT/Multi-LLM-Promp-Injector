{
  "name": "prompt-injector",
  "version": "1.0.0",
  "private": true,
  "description": "Local prompt and file submission to signed-in web LLMs through Playwright.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "web": "node src/local-server.js",
    "test": "node --test",
    "test:http": "node scripts/http-smoke.mjs",
    "test:dom": "node scripts/dom-smoke.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:dom:install": "node scripts/fixture-browser.mjs --install"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@playwright/mcp": "0.0.83"
  }
}
